install_packages ()  {
  apt install -y \
      git \
      curl \
      wget \
      unzip \
      meld \
      yamllint \
      build-essential \
      nfs-common \
      xclip \
      tig \
      keychain
}

install_netbird ()  {
  if [ ! -f /etc/apt/sources.list.d/netbird.list ]; then
    _logInfo "  Adding NetBird apt repository"
    curl -sSL https://pkgs.netbird.io/debian/public.key | gpg --dearmor --output /usr/share/keyrings/netbird-archive-keyring.gpg
    echo 'deb [signed-by=/usr/share/keyrings/netbird-archive-keyring.gpg] https://pkgs.netbird.io/debian stable main' > /etc/apt/sources.list.d/netbird.list
    apt update
  fi

  apt install -y netbird netbird-ui libgtk-4-1 libwebkitgtk-6.0-4 xdg-utils
}
